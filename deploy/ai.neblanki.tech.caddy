# Only this host block belongs to the student portal.
# Keep other hosts in the existing /opt/predel/deploy/Caddyfile unchanged.
ai.neblanki.tech {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    reverse_proxy mgimo-mania:3000
}
