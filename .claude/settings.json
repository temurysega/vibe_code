{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./data/**)",
      "Read(./artifacts/vps-backup-*/**)",
      "Edit(./.env)",
      "Edit(./data/**)",
      "Bash(rm -rf data*)",
      "Bash(rm -rf ./data*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(npm run seed)",
      "Bash(npm run seed *)",
      "PowerShell(npm run seed)",
      "PowerShell(npm run seed *)",
      "PowerShell(npm.cmd run seed)",
      "PowerShell(npm.cmd run seed *)",
      "Bash(node server/seed/run.js)",
      "PowerShell(node server/seed/run.js)",
      "Bash(docker)",
      "Bash(docker *)",
      "PowerShell(docker)",
      "PowerShell(docker *)",
      "Bash(docker-compose *)",
      "PowerShell(docker-compose *)",
      "Bash(ssh *)",
      "PowerShell(ssh *)",
      "Bash(scp *)",
      "PowerShell(scp *)",
      "Bash(gh repo edit *)",
      "PowerShell(gh repo edit *)",
      "Bash(gh repo delete *)",
      "PowerShell(gh repo delete *)"
    ]
  }
}
