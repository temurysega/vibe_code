# Скопируйте в .env и заполните. Файл .env не попадает в репозиторий.

# Порт и адрес сервера
PORT=3000
HOST=0.0.0.0

# production включает Secure-cookie с префиксом __Host- и HSTS
NODE_ENV=development

# Путь к файлу базы SQLite (демо-данные создаются автоматически)
DB_FILE=data/mgimo.db

# Время жизни сессии и простоя, часы
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=2

# За обратным прокси (Render, Nginx): брать IP клиента из X-Forwarded-For
TRUST_PROXY=0

# ИИ-помощник. Ключ хранится только на сервере и никогда не отдаётся в браузер.
# Без ключа помощник отвечает по встроенным правилам на данных студента.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Через сколько часов демо-данные пересоздаются, если стенд простаивает
DEMO_RESEED_HOURS=20
